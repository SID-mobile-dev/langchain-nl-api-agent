# Пример конфигурации. Скопируйте в .env и заполните значения.
# .env — локальный файл секретов, он в .gitignore и НЕ коммитится.

# Ключ LLM-провайдера (OpenAI-совместимый API Xiaomi MiMo)
MIMO_API_KEY=

# Базовый URL OpenAI-совместимого эндпоинта
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Используемая модель (дешёвая/быстрая по умолчанию)
MIMO_MODEL=xiaomi/mimo-v2.6-flash

# Адрес mock API (Task tracker)
API_BASE_URL=http://127.0.0.1:8000
